@@ -145,6 +145,40 @@ map_input_device_to_output(struct cg_seat *seat, struct wlr_input_device *device
 	wlr_log(WLR_INFO, "Couldn't map input device %s to an output\n", device->name);
 }
 
+void
+seat_map_input_devices_to_output(struct cg_seat *seat, struct wlr_output *output)
+{
+	const char *configured_output = getenv("CAGE_TOUCH_OUTPUT");
+	bool is_configured_output = configured_output != NULL && configured_output[0] != '\0';
+	if (is_configured_output && strcmp(configured_output, output->name) != 0) {
+		return;
+	}
+
+	/* Without an explicit target, only fall back when exactly one output is
+	 * present. This keeps upstream's safe behavior on multi-display systems. */
+	bool allow_unassigned = is_configured_output || wl_list_length(&seat->server->outputs) == 1;
+
+	struct cg_touch *touch;
+	wl_list_for_each (touch, &seat->touch, link) {
+		const char *output_name = touch->touch->output_name;
+		if ((output_name && strcmp(output_name, output->name) == 0) || (!output_name && allow_unassigned)) {
+			wlr_log(WLR_INFO, "Mapping touch input device %s to output device %s\n",
+				touch->touch->base.name, output->name);
+			wlr_cursor_map_input_to_output(seat->cursor, &touch->touch->base, output);
+		}
+	}
+
+	struct cg_pointer *pointer;
+	wl_list_for_each (pointer, &seat->pointers, link) {
+		const char *output_name = pointer->pointer->output_name;
+		if ((output_name && strcmp(output_name, output->name) == 0) || (!output_name && allow_unassigned)) {
+			wlr_log(WLR_INFO, "Mapping pointer input device %s to output device %s\n",
+				pointer->pointer->base.name, output->name);
+			wlr_cursor_map_input_to_output(seat->cursor, &pointer->pointer->base, output);
+		}
+	}
+}
+
